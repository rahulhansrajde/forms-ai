NODE_ENV=development
PORT=5000
FRONTEND_ORIGIN=http://localhost:3000

DATABASE_URL=postgres://postgres:change-me@localhost:5432/forms_ai
TEST_DATABASE_URL=postgres://postgres:change-me@localhost:5432/forms_ai_test
DATABASE_SSL=false
DATABASE_MAX_CONNECTIONS=10

SESSION_TTL_HOURS=168
TOKEN_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key

GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback

AI_PROVIDER=bedrock
BEDROCK_API_KEY=your-amazon-bedrock-api-key
BEDROCK_REGION=ap-south-1
BEDROCK_MODELS=zai.glm-5

FRONTEND_DIST_DIRECTORY=
TRUST_PROXY=false
