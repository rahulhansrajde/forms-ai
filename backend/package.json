{
  "name": "@forms-ai/backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../scripts/copy-migrations.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch --env-file-if-exists=../.env src/main.ts",
    "start": "node --env-file-if-exists=../.env dist/main.js",
    "migrate": "tsx --env-file-if-exists=../.env src/migrate.ts",
    "test": "vitest run",
    "test:postgres": "node --env-file-if-exists=../.env ../node_modules/vitest/vitest.mjs run tests/integration"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@forms-ai/contracts": "1.0.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vitest": "^4.0.10"
  }
}
